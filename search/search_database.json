e type ( bounce_integrals_header_t ), intent ( in ) :: header character ( len = 1024 ), dimension ( n_header_lines ) :: lines integer :: file_unit , i lines = header_lines ( header ) open ( newunit = file_unit , file = filename , status = 'replace' , action = 'write' ) do i = 1 , n_header_lines write ( file_unit , '(A)' ) trim ( lines ( i )) end do close ( file_unit ) end subroutine write_bounce_integrals_header subroutine append_bounce_integrals ( filename , fieldline_id , grid ) character ( len =* ), intent ( in ) :: filename integer , intent ( in ) :: fieldline_id type ( integration_grid_t ), intent ( in ) :: grid integer :: file_unit , i_grid open ( newunit = file_unit , file = filename , status = 'old' , & position = 'append' , action = 'write' ) do i_grid = 1 , grid % n write ( file_unit , line_format ) fieldline_id , & grid % t ( i_grid ), & grid % eta ( i_grid ), & grid % bounce_time_weighted ( i_grid ), & grid % I_j ( i_grid ), & grid % radial_drift_weighted ( i_grid ), & grid % poloidal_drift_weighted ( i_grid ) end do close ( file_unit ) end subroutine append_bounce_integrals subroutine read_bounce_integrals ( filename , header , fieldlines , is_complete ) ! Loads all complete fieldlines into fieldlines(:)%grid and writes the ! file back with only those, so new fieldlines append to a clean end. ! Stops if the header does not match the current input and git hash, ! or if the file was written by a dirty build. character ( len =* ), intent ( in ) :: filename type ( bounce_integrals_header_t ), intent ( in ) :: header type ( fieldline_for_precession_t ), dimension (:), intent ( inout ) :: fieldlines logical , dimension (:), intent ( out ) :: is_complete character ( len = 1024 ), dimension ( n_header_lines ) :: expected character ( len = 1024 ) :: line real ( dp ), dimension ( 6 ) :: values integer :: file_unit , ios , i , id , line_id , n_lines expected = header_lines ( header ) open ( newunit = file_unit , file = filename , status = 'old' , action = 'read' ) do i = 1 , n_header_lines read ( file_unit , '(A)' , iostat = ios ) line if ( ios /= 0 ) line = \"\" if ( i == git_hash_line . and . index ( line , \"-dirty\" ) > 0 ) then print * , \"Error: \" , filename , \" was written by a dirty build\" error stop end if if ( line == expected ( i )) cycle print * , \"Error: \" , filename , \" does not match the current input\" print * , \"  file:    \" , trim ( line ) print * , \"  current: \" , trim ( expected ( i )) error stop end do is_complete = . false . id = 0 n_lines = 0 do read ( file_unit , '(A)' , iostat = ios ) line if ( ios /= 0 . or . len_trim ( line ) /= line_width ) exit read ( line , line_format ) line_id , values if ( line_id /= id ) then if ( id > 0 ) is_complete ( id ) = n_lines == fieldlines ( id )% grid % n id = line_id n_lines = 0 end if n_lines = n_lines + 1 fieldlines ( id )% grid % bounce_time_weighted ( n_lines ) = values ( 3 ) fieldlines ( id )% grid % I_j ( n_lines ) = values ( 4 ) fieldlines ( id )% grid % radial_drift_weighted ( n_lines ) = values ( 5 ) fieldlines ( id )% grid % poloidal_drift_weighted ( n_lines ) = values ( 6 ) end do if ( id > 0 ) is_complete ( id ) = n_lines == fieldlines ( id )% grid % n close ( file_unit ) call write_bounce_integrals_header ( filename , header ) do id = 1 , size ( fieldlines ) if ( is_complete ( id )) then call append_bounce_integrals ( filename , id , fieldlines ( id )% grid ) end if end do end subroutine read_bounce_integrals function header_lines ( header ) result ( lines ) type ( bounce_integrals_header_t ), intent ( in ) :: header character ( len = 1024 ), dimension ( n_header_lines ) :: lines lines ( 1 ) = \"# electric_rabe saved bounce integrals\" lines ( git_hash_line ) = \"# git_hash = \" // header % git_hash lines ( 3 ) = \"# field_file = \" // header % field_file write ( lines ( 4 ), '(A, ES26.17E3)' ) \"# s_tor =\" , header % s_tor write ( lines ( 5 ), '(A, I0)' ) \"# n_grid = \" , header % n_grid write ( lines ( 6 ), '(A, I0)' ) \"# max_n_fieldlines = \" , header % max_n_fieldlines write ( lines ( 7 ), '(A, ES26.17E3)' ) \"# M_pol =\" , header % M_pol write ( lines ( 8 ), '(A, ES26.17E3)' ) \"# N_tor =\" , header % N_tor write ( lines ( 9 ), '(A, I0)' ) \"# n_fieldlines = \" , header % n_fieldlines write ( lines ( 10 ), '(A, ES26.17E3)' ) \"# eta_c =\" , header % eta_c write ( lines ( 11 ), '(A, ES26.17E3)' ) \"# eta_t =\" , header % eta_t lines ( 12 ) = \"# columns: fieldline  t  eta  bounce_time_weighted  I_j\" & // \"  radial_drift_weighted  poloidal_drift_weighted\" end function header_lines end module saved_bounce_integrals","tags":"","url":"sourcefile/saved_bounce_integrals.f90.html"},{"title":"fourier.f90 – rabe","text":"This file depends on sourcefile~~fourier.f90~~EfferentGraph sourcefile~fourier.f90 fourier.f90 sourcefile~constants.f90 constants.f90 sourcefile~fourier.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~fourier.f90~~AfferentGraph sourcefile~fourier.f90 fourier.f90 sourcefile~fieldline_labels.f90 fieldline_labels.f90 sourcefile~fieldline_labels.f90->sourcefile~fourier.f90 sourcefile~precession.f90 precession.f90 sourcefile~precession.f90->sourcefile~fourier.f90 sourcefile~shaing_callen.f90 shaing_callen.f90 sourcefile~shaing_callen.f90->sourcefile~fourier.f90 sourcefile~shaing_callen.f90->sourcefile~fieldline_labels.f90 sourcefile~deviation.f90 deviation.f90 sourcefile~deviation.f90->sourcefile~fieldline_labels.f90 sourcefile~electric_rabe.f90 electric_rabe.f90 sourcefile~electric_rabe.f90->sourcefile~fieldline_labels.f90 sourcefile~electric_rabe.f90->sourcefile~precession.f90 sourcefile~make_fieldline.f90 make_fieldline.f90 sourcefile~electric_rabe.f90->sourcefile~make_fieldlin