dp ), dimension (:, :), allocatable :: radial_drift_sin integer :: n_modes end type bounce_integrals_t contains subroutine setup_bounce_integrals ( field , flock , s_tor , bounce_integrals , n_eta , fieldlines_out ) use field_instance , only : initialize_field_instance class ( field_3D_t ), intent ( in ) :: field type ( flock_of_fieldlines_t ), intent ( in ) :: flock real ( dp ), intent ( in ) :: s_tor type ( bounce_integrals_t ), intent ( out ) :: bounce_integrals integer , intent ( in ), optional :: n_eta type ( fieldline_for_precession_t ), dimension (:), allocatable , intent ( out ), optional :: fieldlines_out type ( fieldline_for_precession_t ), dimension (:), allocatable :: fieldlines integer :: idx call make_fieldlines_for_precession ( field , flock , fieldlines , n_eta ) call initialize_field_instance ( field ) do idx = 1 , size ( fieldlines ) call compute_bounce_integrals ( field , & fieldlines ( idx ), & s_tor , & fieldlines ( idx )% grid ) end do call assemble_bounce_integrals ( fieldlines , bounce_integrals ) if ( present ( fieldlines_out )) call move_alloc ( fieldlines , fieldlines_out ) end subroutine setup_bounce_integrals subroutine make_fieldlines_for_precession ( field , flock , fieldlines , n_eta ) class ( field_3D_t ), intent ( in ) :: field type ( flock_of_fieldlines_t ), intent ( in ) :: flock type ( fieldline_for_precession_t ), dimension (:), allocatable , intent ( out ) :: fieldlines integer , intent ( in ), optional :: n_eta real ( dp ) :: eta_t , eta_c type ( integration_grid_t ) :: grid if ( ieee_is_nan ( flock % M_pol )) then print * , \"M_pol: \" , flock % M_pol error stop \"Error: M_pol is NaN.\" end if if ( ieee_is_nan ( flock % N_tor )) then print * , \"N_tor: \" , flock % N_tor error stop \"Error: N_tor is NaN.\" end if if ( ieee_is_nan ( flock % nfp )) then print * , \"nfp: \" , flock % nfp error stop \"Error: nfp is NaN.\" end if if ( ieee_is_nan ( flock % iota )) then print * , \"iota: \" , flock % iota error stop \"Error: iota is NaN.\" end if if ( abs ( flock % M_pol * flock % iota - flock % N_tor ) < machine_eps ) then print * , \"Error-Resonant: M_pol*iota - N_tor must not be zero.\" error stop end if allocate ( fieldlines ( size ( flock % fieldlines ))) fieldlines % fieldline_t = flock % fieldlines fieldlines % M_pol = flock % M_pol fieldlines % N_tor = flock % N_tor fieldlines % nfp = flock % nfp eta_c = 1.0_dp / get_smallest_maximum ( fieldlines ) call set_fieldline_minima ( field , fieldlines ) eta_t = 1.0_dp / get_biggest_minimum ( fieldlines ) call set_integration_grids ( eta_t , eta_c , grid , n_eta = n_eta ) fieldlines % grid = grid end subroutine make_fieldlines_for_precession subroutine assemble_bounce_integrals ( fieldlines , bounce_integrals ) use fourier , only : real_ft type ( fieldline_for_precession_t ), dimension (:), intent ( in ) :: fieldlines type ( bounce_integrals_t ), intent ( out ) :: bounce_integrals real ( dp ), dimension (:, :), allocatable :: radial_drift_weighted real ( dp ), dimension (:, :), allocatable :: radial_drift_cos integer :: n_fieldlines , n_grid , idx n_fieldlines = size ( fieldlines ) n_grid = fieldlines ( 1 )% grid % n bounce_integrals % M_pol = fieldlines ( 1 )% M_pol bounce_integrals % N_tor = fieldlines ( 1 )% N_tor bounce_integrals % nfp = fieldlines ( 1 )% nfp bounce_integrals % iota = fieldlines ( 1 )% iota bounce_integrals % t = fieldlines ( 1 )% grid % t bounce_integrals % eta = fieldlines ( 1 )% grid % eta allocate ( radial_drift_weighted ( n_fieldlines , n_grid )) allocate ( bounce_integrals % avg_bounce_time_weighted ( n_grid )) allocate ( bounce_integrals % avg_I_j ( n_grid )) allocate ( bounce_integrals % avg_magnetic_drift_weighted ( n_grid )) bounce_integrals % avg_bounce_time_weighted = 0.0_dp bounce_integrals % avg_I_j = 0.0_dp bounce_integrals % avg_magnetic_drift_weighted = 0.0_dp do idx = 1 , n_fieldlines radial_drift_weighted ( idx , :) = fieldlines ( idx )% grid % radial_drift_weighted bounce_integrals % avg_bounce_time_weighted = & bounce_integrals % avg_bounce_time_weighted + & fieldlines ( idx )% grid % bounce_time_weighted bounce_integrals % avg_I_j = bounce_integrals % avg_I_j + & fieldlines ( idx )% grid % I_j bounce_integrals % avg_magnetic_drift_weighted = & bounce_integrals % avg_magnetic_drift_weighted + & fieldlines ( idx )% grid % poloidal_drift_weighted end do if ( ignore_magnetic_drift ) then bounce_integrals % avg_magnetic_drift_weighted = 0.0_dp else bounce_integrals % avg_magnetic_drift_weighted = & bounce_integrals % avg_magnetic_drift_weighted / n_fieldlines end if bounce_integrals % avg_bounce_time_weighted = & bounce_integrals % avg_bounce_time_weighted / n_fieldlines bounce_integrals % avg_I_j = bounce_integrals % avg_I_j / n_fieldlines bounce_integrals % n_modes = n_fieldlines / 2 + 1 allocate ( radial_drift_cos ( bounce_integrals % n_modes , n_grid )) allocate ( bounce_integrals % radial_drift_sin ( bounce_integrals % n_modes , n_grid )) do idx = 1 , n_grid call real_ft ( fieldlines % xi_0 , & radial_drift_weighted (:, idx ), & radial_drift_cos (:, idx ), & bounce_integrals % radial_drift_sin (:, idx )) end do end subroutine assemble_bounce_integrals subroutine compute_flux_modes ( bounce_integrals , l_c , Omega_hat , flux_modes ) use splines_instance , only : initialize_splines use splines_instance , only : initialize_prefactor use splines_instance , only : initialize_radial_drift_spline use splines_instance , only : get_flux_mode use splines_instance , only : initialize_startup type ( bounce_integrals_t ), intent ( in ) :: bounce_integrals real ( dp ), intent ( in ) :: l_c real ( dp ), intent ( in ) :: Omega_hat real ( dp ), dimension (:), allocatable , intent ( out ) :: flux_modes real ( dp ), dimension (:), allocatable :: poloidal_drift_weighted real ( dp ), dimension (:), allocatable :: electric_drift_weighted real ( dp ) :: mode_factor integer :: idx allocate ( electric_drift_weighted ( size ( bounce_integrals % t ))) electric_drift_weighted = Omega_hat * bounce_integrals % avg_bounce_time_weighted poloidal_drift_weighted = bounce_integrals % avg_magnetic_drift_weighted + & electric_drift_weighted call initialize_splines ( bounce_integrals % t , & bounce_integrals % eta , & bounce_integrals % avg_I_j , & poloidal_drift_weighted ) allocate ( flux_modes ( bounce_integrals % n_modes )) flux_modes ( 1 ) = 0.0_dp do idx = 2 , bounce_integrals % n_modes mode_factor = 0.5_dp * real ( idx - 1 , dp ) * l_c * bounce_integrals % nfp / & ( bounce_integrals % M_pol * bounce_integrals % iota - bounce_integrals % N_tor ) call initialize_prefactor ( mode_factor ) call initialize_startup ( bounce_integrals % t , bounce_integrals % eta , & bounce_integrals % avg_I_j , mode_factor ) call initialize_radial_drift_spline ( bounce_integrals % t , & bounce_integrals % radial_drift_sin ( idx , :)) call get_flux_mode ( bounce_integrals % t ( 1 ), & bounce_integrals % t ( size ( bounce_integrals % t )), flux_modes ( idx )) end do deallocate ( poloidal_drift_weighted ) deallocate ( electric_drift_weighted ) end subroutine compute_flux_modes !> Longest l_c for which the flux modes are resolved by the eta grid (m=1). !! For large l_c*Omega_hat the solution is confined to a layer at eta_c of !! width delta&#94;2 = eta_c I_B/(|kappa| tau_b) with !! kappa = l_c nfp Omega_hat/(2 (M iota - N)); the layer has to contain !! at least min_points_in_layer grid points (eta - eta_c = k&#94;2 x_1). !! The weak log dependence of tau_b on delta is neglected. function get_max_valid_l_c ( bounce_integrals , Omega_hat ) result ( l_c_max ) type ( bounce_integrals_t ), intent ( in ) :: bounce_integrals real ( dp ), intent ( in ) :: Omega_hat real ( dp ) :: l_c_max real ( dp ), parameter :: min_points_in_layer = 2.0_dp integer :: n real ( dp ) :: eta_c , x_1 , I_B , tau_b , delta_min ! grid runs from deeply (t(1)) to barely trapped (t(n) = 0, eta_c) n = size ( bounce_integrals % t ) eta_c = bounce_integrals % eta ( n ) x_1 = bounce_integrals % eta ( n - 1 ) - eta_c I_B = bounce_integrals % avg_I_j ( n - 1 ) tau_b = bounce_integrals % avg_bounce_time_weighted ( n - 1 ) & / ( 2.0_dp * bounce_integrals % t ( n - 1 )) delta_min = min_points_in_layer ** 2 * x_1 l_c_max = 2.0_dp * eta_c * I_B & * abs ( bounce_integrals % M_pol * bounce_integrals % iota & - bounce_integrals % N_tor ) & / ( bounce_integrals % nfp * abs ( Omega_hat ) * tau_b * delta_min ** 2 ) if ( ieee_is_nan ( l_c_max ) . or . l_c_max <= 0.0_dp ) then print * , \"eta_c, x_1, I_B, tau_b: \" , eta_c , x_1 , I_B , tau_b error stop \"Error: get_max_valid_l_c is not positive.\" end if end function get_max_valid_l_c function get_smallest_maximum ( fieldlines ) result ( smallest_maximum ) class ( fieldline_t ), dimension (:), intent ( in ) :: fieldlines real ( dp ) :: smallest_maximum real ( dp ), dimension ( size ( fieldlines )) :: smallest_maximum_per_line integer :: idx do idx = 1 , size ( fieldlines ) smallest_maximum_per_line ( idx ) = minval ( fieldlines ( idx )% B_max ) end do smallest_maximum = minval ( smallest_maximum_per_line ) if ( smallest_maximum <= 0.0_dp ) then error stop \"Error: Smallest maximum is not positiv.\" end if if ( ieee_is_nan ( smallest_maximum )) then error stop \"Error: Smallest maximum is NaN.\" end if end function get_smallest_maximum subroutine set_fieldline_minima ( field , fieldlines ) class ( field_t ), intent ( in ) :: field class ( fieldline_for_precession_t ), dimension (:), intent ( inout ) :: fieldlines integer :: idx do idx = 1 , size ( fieldlines ) call find_magnetic_well_bottom ( field , & fieldlines ( idx )% fieldline_t , & fieldlines ( idx )% phi_min , & fieldlines ( idx )% B_min ) end do end subroutine set_fieldline_minima function get_biggest_minimum ( fieldlines ) result ( biggest_minimum ) class ( fieldline_for_precession_t ), dimension (:), intent ( in ) :: fieldlines real ( dp ) :: biggest_minimum biggest_minimum = maxval ( fieldlines % B_min ) if ( biggest_minimum <= 0.0_dp ) then error stop \"Error: Biggest minimum is not positiv.\" end if if ( ieee_is_nan ( biggest_minimum )) then error stop \"Error: Biggest minimum is NaN.\" end if end function get_biggest_minimum subroutine find_magnetic_well_bottom ( field , fieldline , phi_bottom , B_bottom ) use find_extrema , only : find_local_minima class ( field_t ), intent ( in ) :: field class ( fieldline_t ), intent ( in ) :: fieldline real ( dp ), intent ( out ) :: phi_bottom , B_bottom integer :: found_minima , of_smallest_B real ( dp ), dimension (:), allocatable :: phi_min , B_min call find_local_minima ( B_along_fieldline , fieldline % phi_max , phi_min ) found_minima = size ( phi_min ) allocate ( B_min ( found_minima )) if ( found_minima < 1 ) then print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"error in find_magnetic_well_bottom: \" print * , \"Found no local minimum in provided interval!\" print * , \"theta_0: \" , fieldline % theta_0 print * , \"phi_0: \" , fieldline % phi_0 print * , \"interval: \" , fieldline % phi_max print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" error stop elseif ( found_minima > 2 ) then print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"warning in find_magnetic_well_bottom: \" print * , \"More than one local minimum in provided interval!\" print * , \"theta_0: \" , fieldline % theta_0 print * , \"phi_0: \" , fieldline % phi_0 print * , \"interval: \" , fieldline % phi_max print * , \"phi_min: \" , phi_min ( 1 : found_minima ) print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" print * , \"---------------------------------------------------------\" end if call B_along_fieldline ( phi_min ( 1 : found_minima ), B_min ( 1 : found_minima )) of_smallest_B = minloc ( B_min ( 1 : found_minima ), dim = 1 ) phi_bottom = phi_min ( of_smallest_B ) B_bottom = B_min ( of_smallest_B ) contains subroutine B_along_fieldline ( phi , B ) real ( dp ), dimension (:), intent ( in ) :: phi real ( dp ), dimension (:), intent ( out ) :: B real ( dp ), dimension ( size ( phi )) :: theta integer :: idx theta = fieldline % get_theta ( phi ) do idx = 1 , size ( phi ) call field % compute_B_mod ( theta ( idx ), phi ( idx ), B ( idx )) end do end subroutine B_along_fieldline end subroutine find_magnetic_well_bottom end module precession","tags":"","url":"sourcefile/precession.f90.html"},{"title":"field_instance.f90 – rabe","text":"This file depends on sourcefile~~field_instance.f90~~EfferentGraph sourcefile~field_instance.f90 field_instance.f90 sourcefile~constants.f90 constants.f90 sourcefile~field_instance.f90->sourcefile~constants.f90 sourcefile~field_base.f90 field_base.f90 sourcefile~field_instance.f90->sourcefile~field_base.f90 sourcefile~field_base.f90->sourcefile~constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~field_instance.f90~~AfferentGraph sourcefile~field_instance.f90 field_instance.f90 sourcefile~electric_rabe.f90 electric_rabe.f90 sourcefile~electric_rabe.f90->sourcefile~field_instance.f90 sourcefile~precession.f90 precession.f90 sourcefile~electric_rabe.f90->sourcefile~precession.f90 sourcefile~grid.f90 grid.f90 sourcefile~electric_rabe.f90->sourcefile~grid.f90 sourcefile~saved_